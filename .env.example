# Canonical origin for the site. Used by metadataBase, canonical URLs, the
# sitemap, robots.txt, and the generated Open Graph image.
#
# Leave unset to use the Vercel production URL baked into lib/site.ts.
# Set this when a custom domain is attached — no code change needed.
#
# NEXT_PUBLIC_SITE_URL=https://alexthuruthel.com
